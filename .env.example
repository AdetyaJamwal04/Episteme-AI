# ==============================================================================
# VeriFact — Environment Configuration Template
# Copy this file to .env and supply your local / API credentials.
# ==============================================================================

# Application Environment (development, staging, production)
VERIFACT_ENVIRONMENT=development
VERIFACT_LOG_LEVEL=INFO
VERIFACT_HOST=0.0.0.0
VERIFACT_PORT=8000

# Database Configuration (PostgreSQL 16 with pgvector)
VERIFACT_DATABASE_URL=postgresql+asyncpg://verifact:verifact_secret@localhost:5432/verifact_db
VERIFACT_DATABASE_POOL_SIZE=10
VERIFACT_DATABASE_MAX_OVERFLOW=20

# Redis Configuration (Cache & Queues)
VERIFACT_REDIS_URL=redis://localhost:6379/0

# Search Provider API Keys
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Reasoning LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Model Device Placement ("cuda", "cpu", "auto")
VERIFACT_DEVICE=auto
VERIFACT_MODEL_CACHE_DIR=~/.cache/huggingface/hub

# Verification Budget Default Caps
VERIFACT_DEFAULT_MAX_SEARCH_QUERIES=12
VERIFACT_DEFAULT_MAX_DOC_FETCHES=8
VERIFACT_DEFAULT_MAX_WALL_TIME_SECONDS=25.0
